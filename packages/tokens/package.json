{
  "name": "@ir/tokens",
  "version": "2.0.0",
  "description": "IR design tokens \u2014 Token Studio source + Style Dictionary build. Cool UntitledUI-modern neutral, brand, status, chart, typography. Light + dark.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "theme.css",
    "themes.css",
    "tokens",
    "build/ramp.mjs",
    "build/ramp.d.mts",
    "build/space.mjs",
    "build/space.d.mts"
  ],
  "exports": {
    ".": {
      "types": "./dist/generated.d.ts"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./theme.css",
    "./themes.css": "./themes.css",
    "./ramp": {
      "types": "./build/ramp.d.mts",
      "default": "./build/ramp.mjs"
    },
    "./presets.json": "./tokens/presets.json",
    "./space": {
      "types": "./build/space.d.mts",
      "default": "./build/space.mjs"
    }
  },
  "scripts": {
    "build": "node build/style-dictionary.config.mjs",
    "check": "node build/style-dictionary.config.mjs && node build/check.mjs",
    "brand:new": "node build/brand-new.mjs",
    "figma:import": "node build/figma-import.mjs"
  },
  "devDependencies": {
    "@tokens-studio/sd-transforms": "^2.0.3",
    "style-dictionary": "^5.4.1"
  }
}
