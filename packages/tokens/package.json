{
  "name": "@ir/tokens",
  "version": "0.1.0",
  "description": "IR design tokens — Token Studio source + Style Dictionary build. Cool UntitledUI-modern neutral, brand, status, chart, typography. Light + dark.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "theme.css",
    "themes.css",
    "tokens",
    "build/ramp.mjs",
    "build/ramp.d.mts"
  ],
  "exports": {
    ".": {
      "types": "./dist/generated.d.ts"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./theme.css",
    "./themes.css": "./themes.css",
    "./ramp": {
      "types": "./build/ramp.d.mts",
      "default": "./build/ramp.mjs"
    }
  },
  "scripts": {
    "build": "node build/style-dictionary.config.mjs",
    "check": "node build/style-dictionary.config.mjs && git diff --exit-code dist/"
  },
  "devDependencies": {
    "@tokens-studio/sd-transforms": "^2.0.3",
    "style-dictionary": "^5.4.1"
  }
}
