    "scale": {
      "1": {
        "$type": "color",
        "$value": "{palette.vis.ir-corporateblue.200}",
        "$description": "Lowest bin. Must stay separable from the card it sits on, not from the next bin."
      },
      "2": {
        "$type": "color",
        "$value": "{palette.vis.ir-corporateblue.400}"
      },
      "3": {
        "$type": "color",
        "$value": "{palette.vis.ir-corporateblue.600}",
        "$description": "Midpoint."
      },
      "4": {
        "$type": "color",
        "$value": "{palette.vis.ir-corporateblue.800}"
      },
      "5": {
        "$type": "color",
        "$value": "{palette.vis.ir-corporateblue.950}",
        "$description": "Highest bin."
      },
      "$description": "The sequential scale — magnitude, not identity. One hue, five bins, ordered. Light runs light to dark and dark runs dark to light: in dark mode nothing can sit below the surface, so the quiet end is the dark end. Never use these for series identity; that is chart/1–6."
    }
