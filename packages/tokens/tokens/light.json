  "ring": {
    "$description": "Focus rings. Layers are in CSS order (first = on top); Figma lists them the other way round.",
    "focus": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{_ring.offset}",
          "x": "0",
          "y": "0",
          "blur": "0",
          "spread": "2px",
          "type": "dropShadow"
        },
        {
          "color": "{_ring.focus}",
          "x": "0",
          "y": "0",
          "blur": "0",
          "spread": "4px",
          "type": "dropShadow"
        }
      ]
    },
    "focus-danger": {
