  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0"
    },
    "xs": {
      "$type": "dimension",
      "$value": "{radius.base} * 0.2"
    },
    "sm": {
      "$type": "dimension",
      "$value": "{radius.base} * 0.6"
    },
    "md": {
      "$type": "dimension",
      "$value": "{radius.base} * 0.8"
    },
    "lg": {
      "$type": "dimension",
      "$value": "{radius.base}"
    },
    "xl": {
      "$type": "dimension",
      "$value": "{radius.base} * 1.4"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "{radius.base} * 1.6"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "{radius.base} * 2.4"
    },
    "4xl": {
      "$type": "dimension",
      "$value": "{radius.base} * 3.2"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    },
    "$description": "Derived from radius.base (set per brand). Multipliers follow shadcn and MUST match the calc() ladder in theme.css; the build fails if they drift. none and full never scale."
  },
  "screen": {
    "mobile": {
      "sm": {
        "$type": "dimension",
        "$value": "320px",
        "$description": "Minimum safe baseline — older/small Android"
      },
      "md": {
        "$type": "dimension",
        "$value": "375px",
        "$description": "iPhone SE, standard iOS baseline"
      },
      "lg": {
        "$type": "dimension",
        "$value": "390px",
        "$description": "iPhone 14/15, modern Android mid-range"
      },
      "xl": {
        "$type": "dimension",
        "$value": "428px",
        "$description": "iPhone Pro Max, large Android"
      }
    },
    "desktop": {
      "sm": {
        "$type": "dimension",
        "$value": "640px",
        "$description": "Tailwind sm. Below IR’s supported floor — present so the ladder is complete, not a size we design for"
      },
      "md": {
        "$type": "dimension",
        "$value": "768px",
        "$description": "Tablet portrait — floor for desktop layouts"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1024px",
        "$description": "Tablet landscape / small laptop"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1280px",
        "$description": "Primary design canvas"
      },
      "wide-laptop": {
        "$type": "dimension",
        "$value": "1440px",
        "$description": "Wide laptop — the widescreen step above xl. Not on Tailwind’s t-shirt ladder — there is no rung between xl and 2xl — so it carries its own name: `wide-laptop:`. Not plain `laptop`: 1024 and 1280 are laptop widths too."
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1536px",
        "$description": "Wide monitors / NOC displays"
      }
    },
    "$description": "Breakpoints use Tailwind’s names and Tailwind’s values, so `lg:` means the same thing in a token file, a Figma page name and a class name. screen/canvas/* are sizes to draw at, not breakpoints."
  },
  "size": {
    "$description": "Layout measurements that are not breakpoints. content/* caps the page content column inside App shell — a max width, never a viewport width. Fluid pages have no cap and no token.",
    "content": {
      "reading": {
        "$type": "dimension",
        "$value": "768px",
        "$description": "Reading width. Caps forms, settings and prose. Left-aligned to the rail, never centred. AppShellContent width=\"reading\"."
      },
      "standard": {
        "$type": "dimension",
        "$value": "1280px",
        "$description": "Standard width. Caps detail, settings and mixed pages; only bites on viewports above 1584 (1280 + 256 rail + 48 padding). AppShellContent width=\"standard\"."
      }
    }
  },
