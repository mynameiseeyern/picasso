  "$description": "Primitives every brand shares: status and vis ramps, the type scale, the radius ladder (as multiples of radius.base), breakpoints and text styles. Per-brand primitives come from brands/<brand>/brand.json + presets.json.",
  "layer": {
    "$description": "Stacking order. GovTech's Singapore Design System scale, which leaves room between rungs rather than counting 1..10. Floating sits ABOVE modal, which inverts GovTech's global order on purpose: Radix portals a tooltip, popover or select menu to document.body, so one opened from inside a dialog has no parent to be scoped by and would render behind it. 2000 is GovTech's own local-layer-floating, used here for exactly that case.",
    "base": {
      "$type": "number",
      "$value": 0,
      "$description": "The page. Nothing needs a utility for this."
    },
    "raised": {
      "$type": "number",
      "$value": 100,
      "$description": "A control lifted above its own siblings — an active OTP slot, a hovered button in a group."
    },
    "overlay": {
      "$type": "number",
      "$value": 800,
      "$description": "The scrim. Below the thing it dims, so stacking does not depend on DOM order."
    },
    "modal": {
      "$type": "number",
      "$value": 1600,
      "$description": "Dialog and Drawer panels."
    },
    "floating": {
      "$type": "number",
      "$value": 2000,
      "$description": "Tooltip, Popover, Select and DropdownMenu content. Above modal so a menu opened inside a dialog is visible."
    },
    "notification": {
      "$type": "number",
      "$value": 3200,
      "$description": "Toast. Clears a modal and anything floating above it; GovTech's local layers run to 2400, so 3200 leaves the gap intact."
    }
  }
}
