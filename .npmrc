# npm 10.9's peer-dependency resolver crashes on this workspace graph with
#   "Cannot read properties of null (reading 'edgesOut')"
# It is an arborist bug, not a bad manifest — every version in packages/ui
# resolves correctly, and the install succeeds the moment peer resolution is
# skipped. Storybook 10 + Vite 8 + React 19 + 13 Radix packages is the trigger.
#
# Keep this until npm fixes it or we move to pnpm, which resolves peers
# differently and suits a monorepo better. Vercel reads this file too, so the
# CI build matches local.
legacy-peer-deps=true
